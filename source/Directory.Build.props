<Project>
	<PropertyGroup>
		<Version>7.0.0</Version>

		<Authors>EhabYT</Authors>
		<Company>EhabYT</Company>
		<Product>EBUninstaller Pro</Product>
		<Copyright>Copyright © 2026 EhabYT. All rights reserved.</Copyright>

		<Platforms>AnyCPU;x64;x86;ARM64</Platforms>
		<TargetFramework>net8.0-windows10.0.18362.0</TargetFramework>
		<TargetPlatformVersion>8.0</TargetPlatformVersion>

		<OutputPath Condition="'$(Platform)' == 'Any CPU' or '$(Platform)' == 'AnyCPU'">..\..\bin\$(Configuration)\AnyCPU\</OutputPath>
		<OutputPath Condition="'$(Platform)' != 'Any CPU' and '$(Platform)' != 'AnyCPU'">..\..\bin\$(Configuration)\$(Platform)\</OutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<Deterministic>true</Deterministic>

		<UseWindowsForms>true</UseWindowsForms>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>

		<GenerateManifests>false</GenerateManifests>
		<SignManifests>false</SignManifests>

		<ApplicationManifest>..\app.manifest</ApplicationManifest>

		<DebugSymbols>true</DebugSymbols>
		<FileAlignment>512</FileAlignment>
		
		<UseAppHost>true</UseAppHost>
		<SelfContained>false</SelfContained>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Nullable>annotations</Nullable>
		<LangVersion>latest</LangVersion>
		<UseSourcePath>true</UseSourcePath>
		<GenerateResourceWarnOnMissingType>true</GenerateResourceWarnOnMissingType>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<GenerateResourceErrorsAsWarnings>true</GenerateResourceErrorsAsWarnings>
	</PropertyGroup>

	<Target Name="UnblockAllProjectFiles" BeforeTargets="BeforeBuild;BeforeResGen;PrepareResourceNames;ResolveAssemblyReferences" Condition="'$(OS)' == 'Windows_NT'">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -NonInteractive -Command &quot;Get-ChildItem -Path '$(MSBuildThisFileDirectory)..' -Filter *.resx -Recurse -ErrorAction SilentlyContinue | Unblock-File -ErrorAction SilentlyContinue&quot;" ContinueOnError="true" IgnoreExitCode="true" />
	</Target>
	
	<Import Project="HelperTools\HelperTools.projitems" Label="Shared" />

	<PropertyGroup Condition=" '$(Platform)' == 'AnyCPU' ">
		<RuntimeIdentifier></RuntimeIdentifier>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Platform)'=='x86'">
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Platform)'=='x64'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Platform)'=='ARM64'">
		<RuntimeIdentifier>win-arm64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<!--<TreatWarningsAsErrors>true</TreatWarningsAsErrors>-->
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DebugType>full</DebugType>
		<CodeAnalysisRuleSet>ExtendedDesignGuidelineRules.ruleset</CodeAnalysisRuleSet>
		<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
	</PropertyGroup>
	
	<ItemGroup>
		<Compile Include="..\GlobalAssemblyInfo.cs"/>
		<None Include="..\Licence.licenseheader">
			<Visible>False</Visible>
		</None>
	</ItemGroup>
</Project>